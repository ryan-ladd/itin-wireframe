      <button class="chip" data-group="status" data-value="published">Published</button>
    </div>
    <div class="filter-actions">
      <button class="filter-clear" onclick="clearFilters()">Clear all</button>
      <button class="filter-apply" onclick="closeFilter()">Show itins</button>
    </div>
  </div>

  <div class="sheet-scrim" id="type-scrim" onclick="closeTypeSheet()"></div>
