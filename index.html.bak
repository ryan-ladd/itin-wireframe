</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
<script>
// --- Screen + day navigation ---
function go(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const screen=document.getElementById(id);
  screen.classList.add('active');
  screen.querySelector('.content').scrollTop = 0;
  const nav=screen.querySelector('.nav');
  if(nav) positionIndicator(nav, nav.querySelector('.ni.on')||nav.querySelector('.ni'), false);
}

// --- Sliding nav highlight ---
function positionIndicator(nav, ni, animate){
  const ind=nav.querySelector('.nav-indicator');
  if(!ind||!ni||!ni.offsetWidth) return;
  const padX=16;
  if(!animate) ind.style.transition='none';
  ind.style.width=(ni.offsetWidth+padX*2)+'px';
  ind.style.transform='translate('+(ni.offsetLeft-padX)+'px,-50%)';
  if(!animate){ void ind.offsetWidth; ind.style.transition=''; }
}
function initNav(nav){
  const items=nav.querySelectorAll('.ni');
  const ind=nav.querySelector('.nav-indicator');
  positionIndicator(nav, nav.querySelector('.ni.on')||items[0], false);
  items.forEach(ni=>{
    ni.addEventListener('click',function(){
      items.forEach(x=>x.classList.remove('on'));
      ni.classList.add('on');
      if(ind) ind.classList.remove('hidden');
      positionIndicator(nav, ni, true);
    });
  });
  const addBtn=nav.querySelector('.nav-add');
  if(addBtn) addBtn.addEventListener('click',function(){
    items.forEach(x=>x.classList.remove('on'));
    if(ind) ind.classList.add('hidden');
  });
}
document.querySelectorAll('.nav').forEach(initNav);
function sd(i,el){
  document.querySelectorAll('#s-trip .dc').forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
  const day=document.getElementById('d'+i);
  if(day) day.scrollIntoView({behavior:'smooth',block:'start'});
  const nav=el.parentElement;
  nav.scrollTo({ left: el.offsetLeft - nav.clientWidth/2 + el.clientWidth/2, behavior:'smooth' });
}

// Long-scroll itinerary: sticky day bar + scroll-spy
(function(){
  const content=document.querySelector('#s-trip .content');
  const screen=document.getElementById('s-trip');
  if(!content) return;
  const chips=[...document.querySelectorAll('#s-trip .dc')];
  const days=[...document.querySelectorAll('#s-trip .day-sec')];
  let ticking=false;
  content.addEventListener('scroll',function(){
    if(ticking) return; ticking=true;
    requestAnimationFrame(function(){
      const hero=content.querySelector('.hero');
      const threshold=(hero?hero.offsetHeight:240)-58;
      screen.classList.toggle('scrolled', content.scrollTop>threshold);
      const contTop=content.getBoundingClientRect().top;
      let idx=0;
      days.forEach((d,i)=>{ if(d.getBoundingClientRect().top-contTop<=170) idx=i; });
      chips.forEach((c,i)=>c.classList.toggle('on', i===idx));
      ticking=false;
    });
  });
})();

// --- Toast ---
let toastTimer;
function toast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),1700);
}

// --- Heart toggle (event delegation) ---
document.addEventListener('click',function(e){
  const hb=e.target.closest('.hb');
  if(hb){
    e.stopPropagation();
    hb.classList.toggle('on');
    hb.classList.add('pop');
    setTimeout(()=>hb.classList.remove('pop'),140);
    toast(hb.classList.contains('on')?'Saved to trip':'Removed');
    return;
  }
});

// --- Tap booking card to copy confirmation # ---
document.querySelectorAll('.ec[data-copy]').forEach(card=>{
  card.addEventListener('click',function(e){
    if(e.target.closest('.ea')||e.target.closest('.hb')) return;
    const ref=card.getAttribute('data-copy');
    copyText(ref, 'Copied confirmation '+ref);
  });
});

// --- Search + filters (Home) ---
let searchQuery='';
const filters={ people:new Set(), when:new Set(), status:new Set() };

function filterTrips(q){ searchQuery=q.trim().toLowerCase(); applyFilters(); }

function applyFilters(){
  let anyVisible=false;
  document.querySelectorAll('#s-home .trip-card').forEach(card=>{
    const hay=(card.getAttribute('data-search')||'').toLowerCase();
    const people=(card.dataset.people||'').split(' ');
    const when=card.dataset.when||'';
    const status=card.dataset.status||'';
    const matchSearch = !searchQuery || hay.includes(searchQuery);
    const matchPeople = filters.people.size===0 || [...filters.people].some(p=>people.includes(p));
    const matchWhen   = filters.when.size===0   || filters.when.has(when);
    const matchStatus = filters.status.size===0 || filters.status.has(status);
    const vis = matchSearch && matchPeople && matchWhen && matchStatus;
    card.style.display = vis ? '' : 'none';
    if(vis) anyVisible=true;
  });
  // hide a section heading if it has no visible trips
  document.querySelectorAll('#s-home .section-label').forEach(label=>{
    const sec=label.dataset.section; if(!sec) return;
    const has=[...document.querySelectorAll('#s-home .trip-card')]
      .some(c=>c.dataset.when===sec && c.style.display!=='none');
    label.style.display = has ? '' : 'none';
  });
  document.getElementById('trip-empty').style.display = anyVisible ? 'none' : 'block';
  const active = filters.people.size||filters.when.size||filters.status.size;
  document.querySelector('.home-filter').classList.toggle('active', !!active);
}

function openFilter(){ document.getElementById('filter-scrim').classList.add('show'); document.getElementById('filter-sheet').classList.add('show'); }
function closeFilter(){ document.getElementById('filter-scrim').classList.remove('show'); document.getElementById('filter-sheet').classList.remove('show'); }
function clearFilters(){
  Object.values(filters).forEach(s=>s.clear());
  document.querySelectorAll('#filter-sheet .chip').forEach(c=>c.classList.remove('on'));
  applyFilters();
}
document.querySelectorAll('#filter-sheet .chip').forEach(chip=>{
  chip.addEventListener('click',function(){
    const g=chip.dataset.group, v=chip.dataset.value;
    if(filters[g].has(v)){ filters[g].delete(v); chip.classList.remove('on'); }
    else { filters[g].add(v); chip.classList.add('on'); }
    applyFilters();
  });
});

// --- Add element (inline, nameable) ---
function addElement(btn){
  const card=document.createElement('div');
  card.className='ec';
  card.innerHTML='<div class="ec-inner">'+
    '<div class="ei" style="background:#EEEDFE;"><svg style="color:#533AB7;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg></div>'+
    '<div class="einfo"><input class="new-el-input" type="text" placeholder="Name this stop…"></div>'+
    '<div class="ea"><span class="hb">♥</span><span class="drag-icon">⠿</span></div>'+
    '</div>';
  btn.parentNode.insertBefore(card,btn);
  const input=card.querySelector('.new-el-input');
  input.focus();
  function commit(){
    const v=input.value.trim();
    if(!v){ card.remove(); return; }
    const info=card.querySelector('.einfo');
    info.innerHTML='<div class="en"></div>';
    info.querySelector('.en').textContent=v;
    toast('Element added');
  }
  input.addEventListener('keydown',ev=>{ if(ev.key==='Enter'){ ev.preventDefault(); input.blur(); }});
  input.addEventListener('blur',commit);
}

// --- Invite / Share bottom sheet ---
function openSheet(){
  document.getElementById('sheet-scrim').classList.add('show');
  document.getElementById('sheet').classList.add('show');
}
function closeSheet(){
  document.getElementById('sheet-scrim').classList.remove('show');
  document.getElementById('sheet').classList.remove('show');
}
function addNewElement(){
  const chips=[...document.querySelectorAll('#s-trip .dc')];
  const active=document.querySelector('#s-trip .dc.on');
  const idx=active?chips.indexOf(active):0;
  const day=document.getElementById('d'+idx);
  const btn=day&&day.querySelector('.add-btn');
  if(btn) addElement(btn);
}
function copyInvite(){ copyText('itin.app/t/pacific-coast-2026','Invite link copied'); }

// --- Clipboard helper (with fallback) ---
function copyText(text,msg){
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(()=>toast(msg)).catch(()=>toast(msg));
  }else{
    const ta=document.createElement('textarea');
    ta.value=text; document.body.appendChild(ta); ta.select();
    try{document.execCommand('copy');}catch(e){}
    document.body.removeChild(ta); toast(msg);
  }
}

// --- Drag-to-reorder within each day ---
// --- Add-element type picker ---
const ELEMENT_TYPES=[
  {key:'flight',label:'Flight',bg:'#E6F1FB',fg:'#185FA5',icon:'<path d="M12 2c-.8 0-1.4 1-1.4 2.3v4.4L2.8 13v2.1l7.8-2.3v4.4l-2.1 1.6V21l3.5-1 3.5 1v-1.2l-2.1-1.6v-4.4l7.8 2.3V13l-7.8-4.3V4.3C13.4 3 12.8 2 12 2z"/>'},
  {key:'car',label:'Car',bg:'#E6F1FB',fg:'#185FA5',icon:'<path d="M18.9 6c-.2-.6-.7-1-1.4-1h-11c-.6 0-1.2.4-1.4 1L3 12v8c0 .6.4 1 1 1h1c.6 0 1-.4 1-1v-1h12v1c0 .6.4 1 1 1h1c.6 0 1-.4 1-1v-8l-2.1-6zM6.5 16c-.8 0-1.5-.7-1.5-1.5S5.7 13 6.5 13s1.5.7 1.5 1.5S7.3 16 6.5 16zm11 0c-.8 0-1.5-.7-1.5-1.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5-.7 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>'},
  {key:'accommodation',label:'Accommodation',bg:'#EEEDFE',fg:'#533AB7',icon:'<path d="M7 13c1.7 0 3-1.3 3-3S8.7 7 7 7 4 8.3 4 10s1.3 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.2-1.8-4-4-4z"/>'},
  {key:'restaurant',label:'Restaurant',bg:'#FBEAF0',fg:'#993556',icon:'<path d="M11 9H9V2H7v7H5V2H3v7c0 2.1 1.7 3.8 3.8 4V22h2.5v-9C11.3 12.8 13 11.1 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.8 0-5 2.2-5 4z"/>'},
  {key:'coffee',label:'Coffee Shop',bg:'#FAEEDA',fg:'#854F0B',icon:'<path d="M20 3H4v10c0 2.2 1.8 4 4 4h6c2.2 0 4-1.8 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z"/>'},
  {key:'bar',label:'Bar',bg:'#FAEEDA',fg:'#854F0B',icon:'<path d="M7 3l1.2 9c.3 1.9 1.8 3.4 3.8 3.8V20H9v2h6v-2h-3v-4.2c2-.4 3.5-1.9 3.8-3.8L17 3H7zm2.1 4l-.3-2h6.4l-.3 2H9.1z"/>'},
  {key:'store',label:'Store',bg:'#EEEDFE',fg:'#533AB7',icon:'<path d="M16 2c0 1.1-1.8 2-4 2S8 3.1 8 2L4 4.5l2 4 2-1V22h8V7.5l2 1 2-4L16 2z"/>'},
  {key:'hike',label:'Hike',bg:'#E1F5EE',fg:'#0F6E56',icon:'<path d="M14 6l-4.2 5.6 1.3 1.7L14 9.3 19 16h-8.5L6.5 10.6 1 18h22L14 6zM5 16l1.5-2 1.5 2H5z"/>'},
  {key:'neighborhood',label:'Neighborhood',bg:'#E1F5EE',fg:'#0F6E56',icon:'<path d="M12 2L6 11h3l-4 6h5v5h4v-5h5l-4-6h3L12 2z"/>'},
  {key:'museum',label:'Museum',bg:'#EEEDFE',fg:'#533AB7',icon:'<path d="M12 1L2 6v2h20V6L12 1zM4 10v7H3v2h18v-2h-1v-7h-2v7h-2v-7h-2v7h-2v-7H9v7H7v-7H4z"/>'},
  {key:'experience',label:'Experience',bg:'#E6F1FB',fg:'#185FA5',icon:'<path d="M13 3v10H5L13 3zm2 4l4.5 6H15V7zM3.3 15h17.4l-1.8 3c-.4.6-1 1-1.7 1H6.8c-.7 0-1.3-.4-1.7-1l-1.8-3z"/>'},
  {key:'ticket',label:'Ticket',bg:'#FBEAF0',fg:'#993556',icon:'<path d="M22 10V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v4c1.1 0 2 .9 2 2s-.9 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2z"/>'},
  {key:'drive',label:'Drive',bg:'#E6F1FB',fg:'#185FA5',icon:'<path fill-rule="evenodd" d="M9 2h6l3 20H6L9 2zm2.2 3h1.6l.3 2h-2.2l.3-2zm.5 5h1.6l.3 2h-2.2l.3-2zm.5 5h1.6l.3 2h-2.2l.3-2z"/>'},
  {key:'misc',label:'Miscellaneous',bg:'#F1EFE8',fg:'#777',icon:'<path d="M12 3a9 9 0 00-9 9 7 7 0 007 7 5 5 0 005-5 3 3 0 00-3-3 1 1 0 00-1 1c0 .6.4 1 1 1a1 1 0 011 1 3 3 0 01-3 3 5 5 0 01-5-5 7 7 0 017-7 9 9 0 019 9 1 1 0 002 0A11 11 0 0012 3z"/>'}
];
function buildTypeSheet(){
  const g=document.getElementById('type-grid');
  if(!g) return;
  g.innerHTML=ELEMENT_TYPES.map(t=>'<div class="type-item" onclick="pickType(\''+t.key+'\')"><div class="type-ic" style="background:'+t.bg+';color:'+t.fg+';"><svg viewBox="0 0 24 24">'+t.icon+'</svg></div><div class="type-name">'+t.label+'</div></div>').join('');
}
function openTypeSheet(){ document.getElementById('type-scrim').classList.add('show'); document.getElementById('type-sheet').classList.add('show'); }
function closeTypeSheet(){ document.getElementById('type-scrim').classList.remove('show'); document.getElementById('type-sheet').classList.remove('show'); }
function pickType(key){
  const t=ELEMENT_TYPES.find(x=>x.key===key); if(!t) return;
  const chips=[...document.querySelectorAll('#s-trip .dc')];
  const active=document.querySelector('#s-trip .dc.on');
  let idx=active?chips.indexOf(active):0; if(idx<0) idx=0;
  const day=document.getElementById('d'+idx);
  const btn=day&&day.querySelector('.add-btn');
  closeTypeSheet();
  if(!btn) return;
  const card=document.createElement('div');
  card.className='ec';
  card.innerHTML='<div class="ec-inner"><div class="ei" style="background:'+t.bg+';color:'+t.fg+';"><svg viewBox="0 0 24 24" style="fill:currentColor;stroke:none;">'+t.icon+'</svg></div><div class="einfo"><input class="new-el-input" type="text" placeholder="Name this '+t.label.toLowerCase()+'…"></div><div class="ea"><span class="hb">♥</span><span class="drag-icon">⠿</span></div></div>';
  btn.parentNode.insertBefore(card,btn);
  const input=card.querySelector('.new-el-input');
  input.focus();
  function commit(){ const v=input.value.trim(); if(!v){ card.remove(); return; } const info=card.querySelector('.einfo'); info.innerHTML='<div class="en"></div><div class="ed">'+t.label+'</div>'; info.querySelector('.en').textContent=v; }
  input.addEventListener('keydown',ev=>{ if(ev.key==='Enter'){ev.preventDefault(); input.blur();} });
  input.addEventListener('blur',commit);
  card.scrollIntoView({behavior:'smooth',block:'center'});
}
buildTypeSheet();

if(window.Sortable){
  document.querySelectorAll('.day-sec').forEach(sec=>{
    Sortable.create(sec,{
      draggable:'.ec',
      handle:'.drag-icon',
      animation:160,
      ghostClass:'drag-ghost',
      chosenClass:'drag-chosen',
      onEnd:()=>toast('Reordered')
    });
  });
}
</script>
</body>
</html>
