      <div class="invite-person"><div class="av" style="background:url('Photos/Ryan%20Profile%20Pic.jpg') center/cover;"></div>Ryan · Owner</div>
      <div class="invite-person"><div class="av" style="background:url('Photos/Emily%20Profile%20Pic.jpeg') center/cover;"></div>Emily · Editor</div>
    </div>
